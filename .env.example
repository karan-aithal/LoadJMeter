# Copy to .env — never commit .env
# ── SUT ──────────────────────────────────────────────
SUT_PORT=3001
SLOW_DELAY_MS=200
FIB_N=35

# ── Monitoring ───────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_PASSWORD=changeme

# ── Control API (Phase 2) ─────────────────────────────
# CONTROL_API_PORT=4000
# JWT_SECRET=changeme-min-32-chars
# API_KEY=changeme
# DATABASE_URL=postgresql://loadtest:changeme@postgres:5432/loadtest

# ── Redis queue (Phase 2-3) ───────────────────────────
# REDIS_URL=redis://redis:6379

# ── Job reaper (control-api) ─────────────────────────
# Requeue jobs whose worker heartbeat is older than REAPER_STALE_MS; MAX_RETRIES also applies in the worker
# REAPER_STALE_MS=20000
# REAPER_INTERVAL_MS=5000

# ── Operator dashboard ───────────────────────────────
# OPS_STREAM_MS=2000                  # SSE snapshot interval for /ops/stream
# VITE_GRAFANA_URL=http://localhost:3002   # UI build arg (compose default is :3001); must match GRAFANA_PORT, rebuild the ui after changing
# Chaos tab data: compose mounts docs/benchmarks/results at /results and sets RESULTS_DIR itself

# ── Worker (Phase 3) ─────────────────────────────────
# CONTROL_API_URL=http://control-api:4000
# HEARTBEAT_INTERVAL_MS=5000
# MAX_RETRIES=3
# DEAD_LETTER_QUEUE=dead-letter

# ── LocalStack / SQS (Phase 9) ───────────────────────
# AWS_ENDPOINT_URL=http://localstack:4566
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
