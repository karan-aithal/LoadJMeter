SUT_PORT=3001
SLOW_DELAY_MS=200
FIB_N=35

# ── Monitoring ───────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_PASSWORD=changeme

