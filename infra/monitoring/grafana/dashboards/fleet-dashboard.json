{
  "title": "LoadTest Fleet (USE)",
  "uid": "loadtest-fleet",
  "tags": ["loadtest", "fleet"],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "time": { "from": "now-30m", "to": "now" },
  "editable": true,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true, "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts", "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Active Workers",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "targets": [{ "expr": "sum(worker_current_job)", "legendFormat": "active", "refId": "A" }]
    },
    {
      "id": 2, "type": "stat", "title": "Fleet CPU Saturation",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 0.8 }] } }, "overrides": [] },
      "targets": [{ "expr": "max(worker_cpu_saturation_ratio)", "legendFormat": "cpu sat", "refId": "A" }]
    },
    {
      "id": 3, "type": "stat", "title": "Jobs Completed",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "sum(worker_jobs_total{outcome=\"pass\"})", "legendFormat": "PASS", "refId": "A" }, { "expr": "sum(worker_jobs_total{outcome=\"fail\"})", "legendFormat": "FAIL", "refId": "B" }, { "expr": "sum(worker_jobs_total{outcome=\"inconclusive\"})", "legendFormat": "INCONCLUSIVE", "refId": "C" }]
    },
    {
      "id": 4, "type": "stat", "title": "Heartbeat Failures (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "targets": [{ "expr": "increase(worker_heartbeat_failures_total[5m])", "legendFormat": "failures", "refId": "A" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Utilisation — Active Workers Over Time",
      "description": "USE: Utilisation = fraction of workers busy",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum(worker_current_job)", "legendFormat": "active jobs", "refId": "A" },
        { "expr": "count(up{job=\"worker\"} == 1)", "legendFormat": "total workers up", "refId": "B" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Saturation — CPU Ratio Per Worker",
      "description": "USE: Saturation = CPU saturation ratio (>0.8 triggers INCONCLUSIVE verdict)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 0.8 }] } },
        "overrides": []
      },
      "targets": [
        { "expr": "max(worker_cpu_saturation_ratio)", "legendFormat": "max CPU sat", "refId": "A" },
        { "expr": "avg(worker_cpu_saturation_ratio)", "legendFormat": "avg CPU sat", "refId": "B" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Errors — Heartbeat Failures + Job Retries",
      "description": "USE: Errors = stall indicators",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "increase(worker_heartbeat_failures_total[1m])", "legendFormat": "heartbeat failures (1m)", "refId": "A" },
        { "expr": "increase(worker_jobs_total{outcome=\"retry\"}[1m])", "legendFormat": "retries (1m)", "refId": "B" },
        { "expr": "increase(worker_jobs_total{outcome=\"failed\"}[1m])", "legendFormat": "DLQ sends (1m)", "refId": "C" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Queue Poll Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(worker_queue_poll_total[1m]))", "legendFormat": "polls/s", "refId": "A" }
      ]
    }
  ],
  "templating": { "list": [] },
  "links": [],
  "weekStart": "",
  "version": 2
}

